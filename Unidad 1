# Ejercicio n7
# Pedir dos números enteros distintos de 0
num1 = int(input("Ingresa el primer número (distinto de 0): "))
num2 = int(input("Ingresa el segundo número (distinto de 0): "))

# Verificar que no sean 0
if num1 == 0 or num2 == 0:
    print("Error: Los números deben ser distintos de 0.")
else:
    # Operaciones
    suma = num1 + num2
    resta = num1 - num2
    multiplicacion = num1 * num2
    division = num1 / num2  # División normal

    # Mostrar resultados
    print(f"Suma: {suma}")
    print(f"Resta: {resta}")
    print(f"Multiplicación: {multiplicacion}")
    print(f"División: {division}")


